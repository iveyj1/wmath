# Fundamental constants (SI units)

# Mathematiical constants - unitless
pi      = 3.1415926535897932384626433832795      # pi
tau     = 6.2831853071795864769252867665590      # 2*pi
e       = 2.7182818284590452353602874713527      # Euler's number
phi     = 1.6180339887498948482045868343656      # golden ratio
psi     = -0.6180339887498948482045868343656     # golden ratio conjugate

# Physical constants
# symbol = value unit                    # quantity -- unit derivation
c      = 2.99792458e8 m/s                # speed of light -- m / s
h      = 6.62607015e-34 J s              # Planck constant -- kg m^2 / s
hbar   = 1.054571817e-34 J s             # reduced Planck constant -- kg m^2 / s
e      = 1.602176634e-19 C               # elementary charge -- A s
kB     = 1.380649e-23 J/K                # Boltzmann constant -- kg m^2 / (s^2 K)
NA     = 6.02214076e23 1/mol             # Avogadro constant -- mol^-1
R      = 8.314462618 J/(mol K)           # gas constant -- kg m^2 / (s^2 mol K)
Fconst = 96485.33212 C/mol               # Faraday constant -- A s / mol

eps0   = 8.8541878128e-12 F/m            # permittivity of free space -- A^2 s^4 / (kg m^3)
mu0    = 1.25663706212e-6 H/m            # permeability of free space -- kg m / (A^2 s^2)
Z0     = 376.730313668 Ohm               # impedance of free space -- kg m^2 / (A^2 s^3)
ke     = 8.9875517923e9 N m^2/C^2        # Coulomb constant -- kg m^3 / (A^2 s^4)

G      = 6.67430e-11 m^3/(kg s^2)        # gravitational constant -- m^3 / (kg s^2)
g0     = 9.80665 m/s^2                   # standard gravity -- m / s^2

sigma  = 5.670374419e-8 W/(m^2 K^4)      # Stefan-Boltzmann constant -- kg / (s^3 K^4)
b      = 2.897771955e-3 m K              # Wien displacement constant -- m K

alpha  = 7.2973525693e-3                 # fine-structure constant -- dimensionless
alpha1 = 137.035999084                   # inverse fine-structure constant -- dimensionless

me     = 9.1093837015e-31 kg             # electron mass -- kg
mp     = 1.67262192369e-27 kg            # proton mass -- kg
mn     = 1.67492749804e-27 kg            # neutron mass -- kg
mu     = 1.66053906660e-27 kg            # atomic mass constant -- kg

a0     = 5.29177210903e-11 m             # Bohr radius -- m
re     = 2.8179403262e-15 m              # classical electron radius -- m

Ry     = 10973731.568160 1/m             # Rydberg constant -- m^-1
Eh     = 4.359744722e-18 J               # Hartree energy -- kg m^2 / s^2

muB    = 9.2740100783e-24 J/T            # Bohr magneton -- A m^2
muN    = 5.0507837461e-27 J/T            # nuclear magneton -- A m^2

Phi0   = 2.067833848e-15 Wb              # magnetic flux quantum -- kg m^2 / (A s^2)
G0     = 7.748091729e-5 S                # conductance quantum -- A^2 s^3 / (kg m^2)
RK     = 25812.80745 Ohm                 # von Klitzing constant -- kg m^2 / (A^2 s^3)

Vm     = 2.241396e-2 m^3/mol             # molar volume (STP) -- m^3 / mol
atm    = 101325 Pa                       # standard atmosphere -- kg / (m s^2)
bar    = 1.0e5 Pa                        # bar -- kg / (m s^2)

eV     = 1.602176634e-19 J               # electron volt -- kg m^2 / s^2
kWh    = 3.6e6 J                         # kilowatt-hour -- kg m^2 / s^2
cal    = 4.184 J                         # thermochemical calorie -- kg m^2 / s^2
